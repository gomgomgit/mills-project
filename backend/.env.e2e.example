# ─────────────────────────────────────────────────────────────────────────
# .env.e2e — environment KHUSUS suite e2e-web (Playwright). Dimuat Laravel
# bila dijalankan dengan --env=e2e:
#   php artisan serve --env=e2e --port=8001
#   php artisan migrate:fresh --env=e2e --force --seed   (lihat e2e-web/scripts/prepare-db.sh)
# Bedanya dari .env hanya: APP_ENV, APP_URL, DB_DATABASE, SANCTUM_STATEFUL_DOMAINS
# dan EVENT_DATE_MAX_DAYS_AHEAD. Database-nya SENDIRI (mill_smart_log_e2e)
# supaya suite tidak mengotori database dev mill_smart_log.
# Salin ke .env.e2e lalu isi APP_KEY/DB_* seperti .env.
# ─────────────────────────────────────────────────────────────────────────
# BE — app (framework core)
APP_NAME="Mills Smart Log"
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# Zona waktu operasional mill (WIB). Lihat config/app.php.
APP_TIMEZONE=Asia/Jakarta
# Batas atas tanggal kejadian data stasiun (hari setelah hari ini). Lihat config/app.php.
# TETAP AKTIF di e2e: spec laporan menanam lajurnya di MASA LALU
# (e2e-web/tests/support/period-lanes.ts), bukan di tahun jauh.
EVENT_DATE_MAX_DAYS_AHEAD=1

# BE — db-client (config/database.php)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mill_smart_log_e2e
DB_USERNAME=postgres
DB_PASSWORD=

# BE — auth-middleware (config/sanctum.php, config/session.php)
# Comma-separated list of domains that should receive stateful (session-cookie)
# API requests from the Livewire web app.
#
# MUST include APP_URL's host:port (localhost:8000). Sanctum turns each entry
# into the pattern "<entry>/*" and matches it against the request's Referer,
# path included — so the bare entry "localhost" produces "localhost/*", which
# does NOT match "localhost:8000/master-data/periods". Added 2026-09-23 after
# finding that every /api/* call made from the app's own frontend answered 401:
# Laravel's own default already appends APP_URL via
# Sanctum::currentApplicationUrlWithPort(), and this override was dropping it.
# The symptom stayed hidden because every web screen uses Livewire, which posts
# to `web` routes and never passes through Sanctum at all — and it is very
# likely the same root cause behind the earlier "Unauthenticated" export bug
# that was patched by adding `web` middleware to 18 export routes.
#
# Deliberately does NOT include localhost:5174 / 127.0.0.1:5174 (the mobile
# app's Vite dev port) — the mobile app always authenticates via Sanctum Bearer
# token, never session; including its origin made
# EnsureFrontendRequestsAreStateful treat every mobile request as stateful/
# CSRF-protected regardless of the Authorization header, causing "CSRF token
# mismatch" (419) on every mutating mobile API call (e.g. sync). Adding
# localhost:8000 does not reintroduce that: the mobile origin is :5174, which
# matches neither "localhost/*" nor "localhost:8000/*".
# e2e: host:port-nya 8001 (APP_URL di atas), bukan 8000.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8001,127.0.0.1,127.0.0.1:8001
SESSION_DRIVER=file
SESSION_LIFETIME=120

# BE — filesystems (config/filesystems.php)
# Local disk on-premise, per shared_decisions.other_decisions (file uploads).
FILESYSTEM_DISK=local

# BE — Mills AI chatbot widget (config/millsai.php)
# Aivena RAG backend project dedicated to Mills Smart Log. See .env's own
# comment for why these are safe to expose client-side (embed-level
# credential, not a per-user secret).
MILLS_AI_BASE_URL=https://demo-chatbot-api.prodemy.id/api/v1
MILLS_AI_PROJECT_ID=
MILLS_AI_AUTH_EMAIL=
MILLS_AI_AUTH_PASSWORD=
