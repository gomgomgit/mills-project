  "ver": 2,
  "id": "screen-001--task-list",
  "name": "Task List",
  "module_id": "module-task",
  "route": "/tasks",
  "auth_requirement": "none",
  "actor_permissions": [
    {
      "actor_id": "actor-single-user",
      "can_access": true,
      "conditions": ""
    }
  ],
  "api_contracts": [
    {
      "usecase_id": "usecase-001--view-task-list",
      "usecase_name": "View Task List",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/tasks",
          "description": "Fetch all tasks sorted by due date ascending",
          "auth_required": false,
          "request": {
            "path_params": [],
            "query_params": [],
            "body_schema": {}
          },
          "response": {
            "success_schema": {
              "tasks": [
                {
                  "id": "integer",
                  "title": "string",
                  "dueDate": "string|null",
                  "isDone": "boolean",
                  "createdAt": "string",
                  "updatedAt": "string"
                }
              ]
            },
            "error_codes": []
          },
          "performance": {
            "cache": "none",
            "rate_limit": "none"
          }
        }
      ],
      "business_logic": [
        "1. Query all tasks from DB ordered by due_date ASC",
        "2. Format response with camelCase fields",
        "3. Return 200 with task list"
      ],
      "data_operations": [
        {
          "entity_id": "task",
          "operation": "SELECT",
          "description": "SELECT all tasks ordered by due_date ASC"
        }
      ],
      "edge_case_handling": [
        {
          "condition": "No tasks exist yet",
          "handling": "Return empty array []"
        }
      ],
      "business_rules_applied": [
        "Tasks sorted by due date ascending by default"
      ]
    },
    {
      "usecase_id": "usecase-002--search-filter-tasks",
      "usecase_name": "Search & Filter Tasks",
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/tasks",
          "description": "Filter tasks by title and status",
          "auth_required": false,
          "request": {
            "path_params": [],
            "query_params": [
              {
                "name": "search",
                "type": "string",
                "required": false,
                "default": "",
                "description": "Partial match on task title"
              },
              {
                "name": "status",
                "type": "string",
                "required": false,
                "default": "all",
                "description": "Filter by done status: pending, done, all"
              }
            ],
            "body_schema": {}
          },
          "response": {
            "success_schema": {
              "tasks": [
                {
                  "id": "integer",
                  "title": "string",
                  "dueDate": "string|null",
                  "isDone": "boolean",
                  "createdAt": "string",
                  "updatedAt": "string"
                }
              ]
            },
            "error_codes": []
          },
          "performance": {
            "cache": "none",
            "rate_limit": "none"
          }
        }
      ],
      "business_logic": [
        "1. Parse and validate query params (search, status)",
        "2. Build WHERE clause: title LIKE %search%, is_done = status filter",
        "3. Execute query with due_date ASC sort",
        "4. Return 200 with filtered results"
      ],
      "data_operations": [
        {
          "entity_id": "task",
          "operation": "SELECT",
          "description": "SELECT tasks with optional WHERE filters, ordered by due_date ASC"
        }
      ],
      "edge_case_handling": [
        {
          "condition": "No search + all status",
          "handling": "Return all tasks (equivalent to GET /tasks)"
        },
        {
          "condition": "Search/filter returns zero results",
          "handling": "Return empty array []"
        }
      ],
      "business_rules_applied": [
        "Tasks sorted by due date ascending by default"
      ]
    },
    {
      "usecase_id": "usecase-003--mark-task-status",
      "usecase_name": "Mark Task Status",
      "endpoints": [
        {
          "method": "PATCH",
          "path": "/api/tasks/:id",
          "description": "Toggle task done/undone status",
          "auth_required": false,
          "request": {
            "path_params": [
              {
                "name": "id",
                "type": "integer",
                "description": "Task ID"
              }
            ],
            "query_params": [],
            "body_schema": {
              "isDone": "boolean"
            }
          },
          "response": {
            "success_schema": {
              "id": "integer",
              "title": "string",
              "dueDate": "string|null",
              "isDone": "boolean",
              "createdAt": "string",
              "updatedAt": "string"
            },
            "error_codes": [
              {
                "http_code": 404,
                "error_code": "TASK_NOT_FOUND",
                "condition": "Task with given ID does not exist"
              }
            ]
          },
          "performance": {
            "cache": "none",
            "rate_limit": "none"
          }
        },
        {
          "method": "DELETE",
          "path": "/api/tasks/:id",
          "description": "Remove task permanently",
          "auth_required": false,
          "request": {
            "path_params": [
              {
                "name": "id",
                "type": "integer",
                "description": "Task ID"
              }
            ],
            "query_params": [],
            "body_schema": {}
          },
          "response": {
            "success_schema": {},
            "error_codes": [
              {
                "http_code": 404,
                "error_code": "TASK_NOT_FOUND",
                "condition": "Task with given ID does not exist"
              }
            ]
          },
          "performance": {
            "cache": "none",
            "rate_limit": "none"
          }
        }
      ],
      "business_logic": [
        "1. Validate task exists → if not: return 404",
        "2. For PATCH: update is_done and updated_at",
        "3. For DELETE: remove task from DB",
        "4. Return 200 with updated task or 204 on delete"
      ],
      "data_operations": [
        {
          "entity_id": "task",
          "operation": "SELECT",
          "description": "SELECT task by ID to validate existence"
        },
        {
          "entity_id": "task",
          "operation": "UPDATE",
          "description": "UPDATE is_done and updated_at"
        },
        {
          "entity_id": "task",
          "operation": "DELETE",
          "description": "DELETE task by ID"
        }
      ],
      "edge_case_handling": [
        {
          "condition": "Task not found",
          "handling": "Return 404 with code TASK_NOT_FOUND"
        }
      ],
      "business_rules_applied": [
        "Deleting a task is immediate — no confirmation dialog needed"
      ]
    }
  ],
  "shared_entities": [
    {
      "entity_id": "task",
      "operations": [
        "SELECT",
        "UPDATE",
        "DELETE"
      ]
    }
  ],
  "screen_dependencies": [],
  "implementation_notes": [
    "SQLite synchronous queries — no async needed",
    "Task list returns all tasks in one query, no pagination required for this scale",
    "Frontend can search/filter client-side for responsiveness but backend supports both options",
    "'Add Task' button must always be visible regardless of task list state (business rule) — do not hide it based on empty task count or task presence"
  ]
}