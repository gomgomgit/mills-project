        }
      ],
      "edge_case_handling": [
        {
          "condition": "Kode duplikat saat create/update",
          "handling": "422 VALIDATION_ERROR, errors.code"
        },
        {
          "condition": "Hapus Production Line yang masih punya Station",
          "handling": "409 PRODUCTION_LINE_HAS_STATIONS, tidak menghapus apa pun"
        },
        {
          "condition": "Update/delete Production Line yang sudah dihapus user lain",
          "handling": "404 NOT_FOUND"
        },
        {
          "condition": "Belum ada Business Unit",
          "handling": "GET business-units/options mengembalikan data: [] kosong, form tidak bisa disimpan (client-side)"
        }
      ],
      "business_rules_applied": [
        "Business Unit wajib dipilih saat create/update",
        "Nama wajib diisi",
        "Kode opsional, unik global (unique-excluding-self saat update)",
        "15 station kanonis diprovisikan HANYA saat create, dalam 1 transaksi dengan Production Line-nya",
        "Update tidak pernah menyentuh station yang sudah ada",
        "Delete ditolak jika masih ada Station terkait",
        "Hanya Admin yang dapat mengakses seluruh endpoint CRUD ini"
      ],
      "unit_test_cases": [
        {
          "description": "berhasil: creates a production line and auto-provisions 15 stations",
          "given": "business_unit_id valid, name terisi",
          "expect": "ProductionLine + 15 Station dibuat, station_count=15"
        },
        {
          "description": "returns 422 when business_unit_id is missing/non-existent",
          "given": "business_unit_id kosong atau tidak ada di DB",
          "expect": "throw ValidationException, errors.business_unit_id"
        },
        {
          "description": "returns 422 when name is empty",
          "given": "name kosong",
          "expect": "throw ValidationException, errors.name"
        },
        {
          "description": "returns 422 when code is already taken (create/update)",
          "given": "code sudah dipakai ProductionLine lain",
          "expect": "throw ValidationException, errors.code"
        },
        {
          "description": "update keeps its own code unchanged without error",
          "given": "update dengan code yang sama seperti sebelumnya",
          "expect": "berhasil, bukan dianggap duplikat"
        },
        {
          "description": "update does not recreate or remove stations",
          "given": "ProductionLine dengan 15 station sudah ada, update name",
          "expect": "station_count tetap 15 setelah update"
        },
        {
          "description": "returns 404 when updating/deleting a non-existent id",
          "given": "id tidak ditemukan",
          "expect": "throw ModelNotFoundException"
        },
        {
          "description": "delete succeeds when there are no related stations",
          "given": "ProductionLine tanpa Station terkait",
          "expect": "ProductionLine terhapus"
        },
        {
          "description": "delete throws ProductionLineHasStationsException when related stations exist",
          "given": "ProductionLine dengan >=1 Station terkait",
          "expect": "throw ProductionLineHasStationsException, tidak menghapus apa pun"
        }
      ]
    }
