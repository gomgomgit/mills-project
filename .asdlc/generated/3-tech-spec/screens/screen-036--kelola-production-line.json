      "business_logic": [
        "list: paginate ProductionLine, eager-load businessUnit, withCount('stations'), filter business_unit_id jika ada → return",
        "create: validate business_unit_id exists, name required, code unique-if-filled → 422 jika invalid → INSERT ProductionLine → foreach 15 DEFAULT_STATIONS: INSERT Station (production_line_id + business_unit_id denormalized) → semua dalam DB::transaction → return row (201)",
        "update: findOrFail id (404 jika tidak ada) → validasi sama seperti create (code unique excluding self) → UPDATE, TIDAK menyentuh station → return row",
        "delete: findOrFail id (404) → COUNT Station WHERE production_line_id=id → jika >0 throw 409 PRODUCTION_LINE_HAS_STATIONS → else DELETE"
      ],
      "data_operations": [
        {
          "entity_id": "production-line",
          "operation": "SELECT",
