# BE — app (framework core)
APP_NAME="Mills Smart Log"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# BE — db-client (config/database.php)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mill_smart_log
DB_USERNAME=root
DB_PASSWORD=

# BE — auth-middleware (config/sanctum.php, config/session.php)
# Comma-separated list of domains that should receive stateful (session-cookie)
# API requests from the Livewire web app — e.g. localhost,localhost:5173,127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=file
SESSION_LIFETIME=120

# BE — filesystems (config/filesystems.php)
# Local disk on-premise, per shared_decisions.other_decisions (file uploads).
FILESYSTEM_DISK=local
