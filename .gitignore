# e2e-web (browser suite for the Laravel app, added 2026-09-16)
/e2e-web/node_modules/
/e2e-web/test-results/
/e2e-web/playwright-report/

# Playwright menulis ini di CWD tempat ia dijalankan. Menjalankan `npx playwright
# test` dari akar repo (bukan dari e2e-web/) menaruhnya di sini, di luar
# /e2e-web/test-results/ yang sudah diabaikan di atas.
/test-results/
/playwright-report/

# Playwright output from the mobile suite — was never ignored, so a local
# run left traces and screenshots staged as untracked noise.
/mobile/test-results/
/mobile/playwright-report/

# Coverage is build output. mobile/coverage/ was committed by mistake and is
# stale (2026-08-20); it should be regenerated, not versioned.
/mobile/coverage/

# local documents
/_local_docs/

# Keluaran antara pembangun Excel QA — diturunkan dari blackbox-test-cases.md
docs/qa/cases.json
# Jejak sementara pelaksana uji QA (trace, screenshot kegagalan)
e2e-web/qa-run/test-results/

