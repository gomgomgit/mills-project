# BE — app (framework core)
APP_NAME="Mills Smart Log"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# BE — db-client (config/database.php)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mill_smart_log
DB_USERNAME=root
DB_PASSWORD=

# BE — auth-middleware (config/sanctum.php, config/session.php)
# Comma-separated list of domains that should receive stateful (session-cookie)
# API requests from the Livewire web app. Do NOT include the mobile app's
# Vite dev port (5173) here — the mobile app always authenticates via
# Sanctum Bearer token, never session; listing its origin makes Sanctum
# require CSRF on every mutating mobile request regardless of the
# Authorization header. See .env's own comment for the full explanation.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=file
SESSION_LIFETIME=120

# BE — filesystems (config/filesystems.php)
# Local disk on-premise, per shared_decisions.other_decisions (file uploads).
FILESYSTEM_DISK=local
