__pycache__/
*.pyc
*.pyo

# Backend (Laravel)
/backend/vendor/
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/storage/*.key
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
!/backend/storage/framework/cache/.gitignore
!/backend/storage/framework/sessions/.gitignore
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/bootstrap/cache/*.php
/backend/public/hot
/backend/public/storage
.phpunit.result.cache
/backend/.phpunit.cache

# Mobile (Vue 3 + Capacitor)
/mobile/node_modules/
/mobile/dist/
/mobile/.env
/mobile/.env.*
!/mobile/.env.example
/mobile/android/
/mobile/ios/
/mobile/*.local

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# e2e-web (browser suite for the Laravel app, added 2026-09-16)
/e2e-web/node_modules/
/e2e-web/test-results/
/e2e-web/playwright-report/

# Playwright output from the mobile suite — was never ignored, so a local
# run left traces and screenshots staged as untracked noise.
/mobile/test-results/
/mobile/playwright-report/

# Coverage is build output. mobile/coverage/ was committed by mistake and is
