# FE — api-client (src/services/apiClient.ts)
# Base URL of the backend Laravel API. Point this at the dev server during
# `vite dev`, and at the deployed on-premise API URL for packaged builds.
VITE_API_BASE_URL=http://localhost:8000

# FE — Mills AI chatbot (src/services/millsAiChatApi.ts)
# Aivena RAG backend project dedicated to Mills Smart Log — see .env's own
# comment for why these are safe to bundle client-side.
VITE_MILLS_AI_BASE_URL=https://demo-chatbot-api.prodemy.id/api/v1
VITE_MILLS_AI_PROJECT_ID=
VITE_MILLS_AI_AUTH_EMAIL=
VITE_MILLS_AI_AUTH_PASSWORD=
